	(text "Edge pads are hand-soldered castellations. EN, MTMS and BOOT are pads on the underside:\neach lands on a plated hole, soldered from the back of the carrier.\nD6/D7 = UART0 TX/RX (GPIO11/12). MTMS = GPIO2 = OFT_SYNC_GPIO default."
		(exclude_from_sim no)
		(at 215.9 21.59 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "5e6c1320-8f75-5c3f-8582-ff85bdc6e800")
