	(text "TIMER: Waveshare RP2350-POE-ETH (socketed, two 1x16 female sockets)"
		(exclude_from_sim no)
		(at 17.78 17.78 0)
		(effects (font (size 1.6 1.6)) (justify left))
		(uuid "a9111a6b-0d10-51e6-9377-de2b1d44eba7")
	)
	(text "W6300 Ethernet uses GP16 to GP21 on the module itself. PoE module plugs on top.\nslot 1 = UART1, slot 2 = UART0. All links 921600 baud.\nUART1 (GP4/GP5) is the pair the single-Node firmware uses.\nGP6 = SYNC, GP7 = EN, GP8 = BOOT, shared by every slot."
		(exclude_from_sim no)
		(at 17.78 21.59 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "a0387b11-893e-56f5-827d-a92d42b691fc")
	)
